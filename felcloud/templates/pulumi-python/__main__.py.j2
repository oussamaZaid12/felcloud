{% set net = a.network %}
"""Projet {{ a.project }} — généré par felcloud le {{ generated_on }}.

Pulumi exécute ce programme Python et crée sur le cloud « {{ a.cloud }} » les
ressources qu'il décrit. Lis-le de haut en bas : chaque bloc crée une ressource.
Pulumi déduit tout seul l'ordre de création à partir des liens entre elles
(par exemple network_id=network.id : le réseau doit exister avant le sous-réseau).
"""

from pathlib import Path

import pulumi
import pulumi_openstack as openstack

PROJECT = {{ a.project | tojson }}
HERE = Path(__file__).parent

# ---------------------------------------------------------------------------
# Connexion au cloud
# ---------------------------------------------------------------------------
# Aucun mot de passe ni secret ici : Pulumi lit l'entrée {{ a.cloud | tojson }} du
# fichier ~/.config/openstack/clouds.yaml, qui reste sur ta machine.
provider = openstack.Provider("openstack", cloud={{ a.cloud | tojson }})
opts = pulumi.ResourceOptions(provider=provider)
read_opts = pulumi.InvokeOptions(provider=provider)
{% if net %}

# ---------------------------------------------------------------------------
# Réseau
# ---------------------------------------------------------------------------
{% if net.external_network %}
# Réseau externe fourni par le cloud : source des adresses IP publiques. On ne le
# crée pas, on le lit (fonction get_...).
external_network = openstack.networking.get_network(
    name={{ net.external_network | tojson }}, external=True, opts=read_opts
)
{% endif %}
{% if net.mode == "create" %}

# Réseau privé du projet : les machines y reçoivent une adresse interne.
network = openstack.networking.Network(
    "network",
    name=f"{PROJECT}-net",
    admin_state_up=True,
    opts=opts,
)

# Plage d'adresses du réseau privé. Le DHCP distribue les adresses aux machines ;
# les serveurs DNS servent aux machines qui ont accès à Internet.
subnet = openstack.networking.Subnet(
    "subnet",
    name=f"{PROJECT}-subnet",
    network_id=network.id,
    cidr={{ net.cidr | tojson }},
    ip_version=4,
    enable_dhcp=True,
    dns_nameservers={{ net.dns | tojson }},
    opts=opts,
)

# Routeur relié au réseau externe : indispensable pour rattacher des IP publiques.
# Attention : sur FelCloud, il ne donne PAS Internet aux machines sans IP publique.
router = openstack.networking.Router(
    "router",
    name=f"{PROJECT}-router",
    external_network_id=external_network.id,
    opts=opts,
)

# Branche le sous-réseau privé sur le routeur.
router_interface = openstack.networking.RouterInterface(
    "router-interface",
    router_id=router.id,
    subnet_id=subnet.id,
    opts=opts,
)

network_id = network.id
{% else %}

# Réseau existant du projet, choisi dans l'assistant. On le lit sans le gérer :
# `pulumi destroy` ne le supprimera pas.
existing_network = openstack.networking.get_network(name={{ net.name | tojson }}, opts=read_opts)
network_id = existing_network.id
{% endif %}
{% endif %}
{% if a.security_group %}
{% set sgr = a.security_group %}

# ---------------------------------------------------------------------------
# Pare-feu (security group)
# ---------------------------------------------------------------------------
# Tout le trafic ENTRANT est bloqué par défaut : chaque règle ouvre une porte précise.
# Le trafic sortant est autorisé.
security_group = openstack.networking.SecGroup(
    "secgroup",
    name=f"{PROJECT}-sg",
    description=f"Pare-feu du projet {PROJECT} (généré par felcloud)",
    opts=opts,
)
{% if "ssh" in sgr.rules %}

# SSH (port 22) : se connecter aux machines.
openstack.networking.SecGroupRule(
    "rule-ssh",
    security_group_id=security_group.id,
    direction="ingress",
    ethertype="IPv4",
    protocol="tcp",
    port_range_min=22,
    port_range_max=22,
    remote_ip_prefix={{ sgr.ssh_cidr | tojson }},
    opts=opts,
)
{% endif %}
{% if "http" in sgr.rules %}

# HTTP (port 80) : site web.
openstack.networking.SecGroupRule(
    "rule-http",
    security_group_id=security_group.id,
    direction="ingress",
    ethertype="IPv4",
    protocol="tcp",
    port_range_min=80,
    port_range_max=80,
    remote_ip_prefix="0.0.0.0/0",
    opts=opts,
)
{% endif %}
{% if "https" in sgr.rules %}

# HTTPS (port 443) : site web sécurisé.
openstack.networking.SecGroupRule(
    "rule-https",
    security_group_id=security_group.id,
    direction="ingress",
    ethertype="IPv4",
    protocol="tcp",
    port_range_min=443,
    port_range_max=443,
    remote_ip_prefix="0.0.0.0/0",
    opts=opts,
)
{% endif %}
{% if "icmp" in sgr.rules %}

# Ping (ICMP) : vérifier qu'une machine répond.
openstack.networking.SecGroupRule(
    "rule-icmp",
    security_group_id=security_group.id,
    direction="ingress",
    ethertype="IPv4",
    protocol="icmp",
    remote_ip_prefix="0.0.0.0/0",
    opts=opts,
)
{% endif %}
{% if "internal" in sgr.rules %}

# Trafic libre entre les machines de ce pare-feu : la source autorisée est le
# groupe lui-même. La règle reste valable si tu ajoutes des machines.
openstack.networking.SecGroupRule(
    "rule-internal",
    security_group_id=security_group.id,
    direction="ingress",
    ethertype="IPv4",
    remote_group_id=security_group.id,
    opts=opts,
)
{% elif proxy %}

# Proxy (port 3128) du bastion {{ proxy.bastion }}, réservé aux machines du projet :
# c'est par lui que les machines sans IP publique accèdent à Internet.
openstack.networking.SecGroupRule(
    "rule-proxy",
    security_group_id=security_group.id,
    direction="ingress",
    ethertype="IPv4",
    protocol="tcp",
    port_range_min=3128,
    port_range_max=3128,
    remote_group_id=security_group.id,
    opts=opts,
)
{% endif %}
{% if sgr.custom_tcp_ports %}

# Ports TCP supplémentaires. Pour en ouvrir d'autres, ajoute-les à cette liste.
CUSTOM_TCP_PORTS = {{ sgr.custom_tcp_ports | tojson }}
for port in CUSTOM_TCP_PORTS:
    openstack.networking.SecGroupRule(
        f"rule-tcp-{port}",
        security_group_id=security_group.id,
        direction="ingress",
        ethertype="IPv4",
        protocol="tcp",
        port_range_min=port,
        port_range_max=port,
        remote_ip_prefix="0.0.0.0/0",
        opts=opts,
    )
{% endif %}
{% endif %}
{% if a.keypair %}

# ---------------------------------------------------------------------------
# Clé SSH
# ---------------------------------------------------------------------------
{% if a.keypair.mode == "existing" %}
# Clé déjà enregistrée sur le cloud : on utilise simplement son nom.
key_pair_name = {{ a.keypair.name | tojson }}
{% else %}
# Seule la partie PUBLIQUE est envoyée au cloud ; elle est injectée dans les
# machines au premier démarrage. La clé privée ({{ a.keypair.private_key_path }})
# ne quitte jamais ta machine.
public_key = Path({{ a.keypair.public_key_path | tojson }}).expanduser().read_text().strip()
keypair = openstack.compute.Keypair(
    "keypair",
    name={{ a.keypair.name | tojson }},
    public_key=public_key,
    opts=opts,
)
key_pair_name = keypair.name
{% endif %}
{% endif %}
{% if a.instances %}

# ---------------------------------------------------------------------------
# Machines virtuelles
# ---------------------------------------------------------------------------
# La liste des machines. Pour en ajouter une, copie une ligne et change le nom.
#   floating_ip : True = adresse publique. Sur FelCloud, c'est aussi la seule façon
#                 d'accéder directement à Internet.
#   cloud_init  : script exécuté au premier démarrage ("" = aucun).
INSTANCES = {
{% for vm in a.instances %}
    {{ vm.name | tojson }}: {"image": {{ vm.image | tojson }}, "flavor": {{ vm.flavor | tojson }}, "floating_ip": {{ "True" if vm.floating_ip else "False" }}, "cloud_init": {{ cloud_init[vm.name] | tojson }}, "ssh_user": {{ vm.ssh_user | tojson }}},
{% endfor %}
}
{% if net.mode == "create" %}

# Le réseau doit être entièrement branché avant le démarrage des machines.
after_network = pulumi.ResourceOptions(provider=provider, depends_on=[router_interface])
{% else %}

after_network = opts
{% endif %}

# Carte réseau de chaque machine, créée explicitement : c'est sur elle qu'on
# rattache le pare-feu et, si besoin, l'adresse IP publique.
ports = {}
for name in INSTANCES:
    ports[name] = openstack.networking.Port(
        f"{name}-port",
        name=f"{name}-port",
        network_id=network_id,
        admin_state_up=True,
{% if sg %}
        security_group_ids=[security_group.id],
{% endif %}
{% if net.mode == "create" %}
        fixed_ips=[openstack.networking.PortFixedIpArgs(subnet_id=subnet.id)],
{% endif %}
        opts=opts,
    )
{% if proxy %}

# Adresse privée du bastion {{ proxy.bastion }}, dont le proxy (port 3128) donne
# Internet aux machines sans IP publique. Elle est insérée dans leur script de démarrage.
proxy_address = ports[{{ proxy.bastion | tojson }}].all_fixed_ips[0]
{% endif %}
{% if roles_used %}


def startup_script(vm):
    """Contenu du script cloud-init de la machine (ou None)."""
    if not vm["cloud_init"]:
        return None
    text = (HERE / vm["cloud_init"]).read_text()
{% if proxy %}
    if "${proxy}" in text:
        return proxy_address.apply(lambda ip: text.replace("${proxy}", ip))
{% endif %}
    return text
{% endif %}


instances = {}
for name, vm in INSTANCES.items():
    instances[name] = openstack.compute.Instance(
        name,
        name=name,
        image_name=vm["image"],
        flavor_name=vm["flavor"],
{% if keypair_ref %}
        key_pair=key_pair_name,
{% endif %}
        # Clé SSH et script de démarrage fournis sur un petit disque attaché à la
        # machine : plus fiable que le service réseau de métadonnées.
        config_drive=True,
{% if roles_used %}
        user_data=startup_script(vm),
{% endif %}
        networks=[openstack.compute.InstanceNetworkArgs(port=ports[name].id)],
        opts=after_network,
    )
{% if any_fip %}

# Adresses IP publiques, pour les machines marquées floating_ip=True.
# subnet_id est précisé en plus du pool : sur FelCloud, une allocation par le
# seul nom du réseau peut échouer avec « ExternalIpAddressExhausted ».
floating_ips = {}
for name, vm in INSTANCES.items():
    if vm["floating_ip"]:
        floating_ips[name] = openstack.networking.FloatingIp(
            f"{name}-fip",
            pool=external_network.name,
            subnet_id=external_network.subnets[0],
            port_id=ports[name].id,
            opts=after_network,
        )
{% endif %}
{% endif %}
{% if a.volumes %}

# ---------------------------------------------------------------------------
# Volumes : des disques supplémentaires, indépendants des machines
# ---------------------------------------------------------------------------
VOLUMES = {
{% for vol in a.volumes %}
    {{ vol.name | tojson }}: {"size_gb": {{ vol.size }}, "type": {{ (vol.type or none) | tojson | replace("null", "None") }}, "attach_to": {{ (vol.attach_to or none) | tojson | replace("null", "None") }}},
{% endfor %}
}

for name, vol in VOLUMES.items():
    volume = openstack.blockstorage.Volume(
        name,
        name=name,
        size=vol["size_gb"],
        volume_type=vol["type"],
        opts=opts,
    )
    # Branchement sur une machine : le disque y apparaît comme /dev/vdb (puis vdc...).
    # Il faut encore le formater et le monter (voir README.md).
    if vol["attach_to"]:
        openstack.compute.VolumeAttach(
            f"{name}-attach",
            instance_id=instances[vol["attach_to"]].id,
            volume_id=volume.id,
            opts=opts,
        )
{% endif %}

# ---------------------------------------------------------------------------
# Sorties : affichées à la fin de `pulumi up`, et à tout moment avec
# `pulumi stack output`
# ---------------------------------------------------------------------------
{% if a.instances %}
pulumi.export("machines", {
    name: {
        "ip_privee": instance.access_ip_v4,
{% if any_fip %}
        "ip_publique": floating_ips[name].address if name in floating_ips else "aucune",
{% else %}
        "ip_publique": "aucune",
{% endif %}
    }
    for name, instance in instances.items()
})
{% if any_fip %}

# Commandes pour se connecter (patiente ~2 minutes après la création).
SSH_KEY = {{ (private_key or "<ta-clé-privée>") | tojson }}
pulumi.export("ssh", {
    name: pulumi.Output.concat("ssh -i ", SSH_KEY, " ", INSTANCES[name]["ssh_user"], "@", fip.address)
    for name, fip in floating_ips.items()
})
{% if has_private_vms %}

# Les machines sans IP publique se rejoignent en passant par {{ jump.name }} (« rebond »).
# ProxyCommand transmet la clé aux deux connexions, contrairement à -J.
JUMP = {{ jump.name | tojson }}
pulumi.export("ssh_via_rebond", {
    name: pulumi.Output.concat(
        "ssh -i ", SSH_KEY, " -o ProxyCommand='ssh -i ", SSH_KEY, " -W %h:%p ",
        INSTANCES[JUMP]["ssh_user"], "@", floating_ips[JUMP].address, "' ",
        INSTANCES[name]["ssh_user"], "@", instance.access_ip_v4,
    )
    for name, instance in instances.items()
    if not INSTANCES[name]["floating_ip"]
})
{% endif %}
{% endif %}
{% endif %}
{% if net and net.mode == "create" %}
pulumi.export("reseau", pulumi.Output.concat(network.name, " (", subnet.cidr, ")"))
{% endif %}
